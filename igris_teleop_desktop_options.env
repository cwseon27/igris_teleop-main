# IGRIS Teleop desktop launcher options.
#
# This file is sourced by run_igris_teleop.sh. Use shell syntax.
# After editing this file, launch "IGRIS Teleop" again from the Desktop icon.

# Extra arguments passed to: python -m igris_teleop.main
# Keep this as a bash array so paths containing spaces can be quoted safely.
IGRIS_MAIN_ARGS=(
  # --mode teleop
  # --teleop-device unity
  # --web-open-browser
)

# Web UI options.
IGRIS_WEB_HOST=127.0.0.1
IGRIS_WEB_PORT=8000
IGRIS_WEB_OPEN_BROWSER=1
